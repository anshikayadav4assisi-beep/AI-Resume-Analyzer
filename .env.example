# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider used for narrative feedback (explanation, suggestions).
# The app works fully without this — it falls back to deterministic
# template-based feedback if the key is missing or the call fails.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Optional, only if you swap llm_service.py to use OpenAI instead.
OPENAI_API_KEY=

# Sentence Transformers model used for semantic similarity.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Upload limits and behavior.
MAX_UPLOAD_MB=10

# Scoring weights (must sum to 1.0).
WEIGHT_SKILL_MATCH=0.40
WEIGHT_SEMANTIC_SIMILARITY=0.30
WEIGHT_EXPERIENCE_MATCH=0.20
WEIGHT_EDUCATION_MATCH=0.10
